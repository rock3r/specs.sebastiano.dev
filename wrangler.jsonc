{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sebastiano-specs",
  "main": "src/index.mjs",
  "account_id": "bde5200bb4a2da7c163c14e88348f5e2",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "specs.sebastiano.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "FRAME_PACING",
      "service": "frame-pacing"
    },
    {
      "binding": "ACTIONS",
      "service": "jewel-shortcuts-review"
    },
    {
      "binding": "PIONEER_PROFILE_FILE_DESIGN",
      "service": "pioneer-profile-file-design"
    },
    {
      "binding": "PUNARO_INDIRECT_INTERNET_ARCHITECTURE",
      "service": "punaro-indirect-internet-architecture"
    },
    {
      "binding": "COMPOSE_STACK_TRACES",
      "service": "compose-stack-traces"
    }
  ]
}
